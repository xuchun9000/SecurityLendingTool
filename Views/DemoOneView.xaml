<UserControl x:Class="SecurityLendingTool.Views.DemoOneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:SecurityLendingTool.Behaviors"
             xmlns:vm="clr-namespace:SecurityLendingTool.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DemoOneViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   FontSize="14"
                   Text="SelectionUnit=Cell — F3/F4 move selection down/up between data rows (empty rows skipped), wraps at ends (via DataGridCellSelectionBehavior)." />

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,8"
                   FontSize="14"
                   Text="{Binding SelectedPeople.Name, StringFormat=Selected: {0}, TargetNullValue=Selected: (none), FallbackValue=Selected: (none)}" />

        <DataGrid
                  Grid.Row="2"
                  ItemsSource="{Binding People}"
                  b:DataGridCellSelectionBehavior.IsEnabled="True"
                  b:DataGridCellSelectionBehavior.SelectedItem="{Binding SelectedPeople, Mode=TwoWay}"
                  b:DataGridSelectionStatsBehavior.IsEnabled="True"
                  b:DataGridSelectionStatsBehavior.Count="{Binding SelectionCount, Mode=OneWayToSource}"
                  b:DataGridSelectionStatsBehavior.Sum="{Binding SelectionSum, Mode=OneWayToSource}"
                  b:DataGridSelectionStatsBehavior.Average="{Binding SelectionAverage, Mode=OneWayToSource}"
                  b:DataGridSelectionStatsBehavior.SelectedRows="{Binding SelectedRows, Mode=OneWayToSource}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionUnit="Cell"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternatingRowBackground="#FFF5F5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    MinWidth="120" />
                <DataGridTextColumn Header="Age"
                                    Binding="{Binding Age}"
                                    Width="80" />
                <DataGridTextColumn Header="Score"
                                    Binding="{Binding Score, StringFormat=N2}"
                                    Width="80" />
                <DataGridTextColumn Header="City"
                                    Binding="{Binding City}"
                                    Width="*"
                                    MinWidth="100" />
                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="2*"
                                    MinWidth="180" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selection statistics (bottom-right), fed by DataGridSelectionStatsBehavior via the ViewModel. -->
        <Border Grid.Row="3"
                Margin="0,8,0,0"
                Padding="8,4"
                HorizontalAlignment="Right"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1"
                Background="#FFF9F9F9">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding SelectionCount, StringFormat=Count: {0}}" />
                    <TextBlock Margin="16,0,0,0" Text="{Binding SelectionAverage, StringFormat=Average: {0:N2}}" />
                    <TextBlock Margin="16,0,0,0" Text="{Binding SelectionSum, StringFormat=Sum: {0:N2}}" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectionCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
                <TextBlock Text="Count/Average/Sum: (none)" Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectionCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
