<Window x:Class="SecurityLendingTool.Views.ScheduleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schedule"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" MinWidth="260">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Start time (HH:mm):" VerticalAlignment="Center" Margin="0,0,8,6" />
            <TextBox Grid.Row="0" Grid.Column="1" Width="80" Margin="0,0,0,6" HorizontalAlignment="Left"
                     Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stop time (HH:mm):" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left"
                     Text="{Binding StopTimeText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Retry interval (sec):" VerticalAlignment="Center" Margin="0,6,8,0" />
            <TextBox Grid.Row="2" Grid.Column="1" Width="80" Margin="0,6,0,0" HorizontalAlignment="Left"
                     Text="{Binding RetryIntervalText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <TextBlock Text="{Binding ErrorText}" Foreground="#C00000" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="260" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="70" Margin="0,0,8,0" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Content="Cancel" Width="70" IsCancel="True" Command="{Binding CancelCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
