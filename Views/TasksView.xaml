<UserControl x:Class="SecurityLendingTool.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecurityLendingTool.ViewModels"
             xmlns:conv="clr-namespace:SecurityLendingTool.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="700"
             d:DataContext="{d:DesignInstance Type=vm:TasksViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <conv:ProgressToBackgroundConverter x:Key="ProgressToBackgroundConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="Tasks"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="Run All"
                    Width="80"
                    Command="{Binding RunAllSLTasksCommand}" />
            <Button DockPanel.Dock="Right"
                    Content="{Binding ScanButtonText}"
                    Width="80"
                    Margin="0,0,8,0"
                    Command="{Binding ToggleScanCommand}" />
            <Button DockPanel.Dock="Right"
                    Content="Schedule..."
                    Width="80"
                    Margin="0,0,8,0"
                    Command="{Binding OpenScheduleCommand}" />
            <Button DockPanel.Dock="Right"
                    Content="View Message History"
                    Padding="8,0"
                    Margin="0,0,8,0"
                    Command="{Binding ViewMessageHistoryCommand}" />
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding ScanStatusText}"
                       Foreground="Gray"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center" />
        </DockPanel>
        <!-- Countdown to the next pass; only visible while waiting between passes. -->
        <Grid DockPanel.Dock="Top"
              Height="20"
              Margin="0,0,0,8"
              Visibility="{Binding IsWaitingForRetry, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding RetryWaitProgress, Mode=OneWay}"
                         Foreground="#FF9FD89F" />
            <TextBlock Text="{Binding RetryCountdownText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
        <DataGrid ItemsSource="{Binding SLTasks}"
                  SelectedItem="{Binding SelectedSLTask}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="All"
                  RowHeaderWidth="32"
                  LoadingRow="SLTasksGrid_LoadingRow"
                  GridLinesVisibility="None">
            <DataGrid.RowStyle>
                <!-- The whole row is the progress bar: light green fill up to Progress, transparent after. -->
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Progress, Converter={StaticResource ProgressToBackgroundConverter}}" />
                    <!-- Faint dashed separator under each row (4px dash, 3px gap). -->
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <DrawingBrush Viewport="0,0,7,1" ViewportUnits="Absolute" TileMode="Tile">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,7,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#FFCCCCCC">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,4,1" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- Failed rows: whole row light red instead of the progress fill. -->
                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter Property="Background" Value="#FFFFE0E0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="120" />
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Start"
                                    Width="60"
                                    Margin="4,1"
                                    Command="{Binding DataContext.StartSLTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Stop"
                                    Width="60"
                                    Margin="4,1"
                                    Command="{Binding DataContext.StopSLTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <!-- Finished but not Completed (Failed / Canceled / Skipped): bold red. -->
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="Foreground" Value="Green" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Canceled">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="History"
                                    Width="60"
                                    Margin="4,1"
                                    Command="{Binding DataContext.ShowSLTaskHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="8,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <!-- About 50 characters per line, then wrap. -->
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="MaxWidth" Value="350" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="ToolTip" Value="{Binding Message}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>