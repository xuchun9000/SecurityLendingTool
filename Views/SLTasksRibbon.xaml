<UserControl x:Class="SecurityLendingTool.Views.SLTasksRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SecurityLendingTool.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:TasksViewModel, IsDesignTimeCreatable=True}">
    <!-- Ribbon for the Tasks tab; shown in MainWindow only while the Tasks tab is selected. DataContext: TasksViewModel. -->
    <UserControl.Resources>
        <!-- Ribbon look: large button with a 20px vector icon (geometry in Tag) and the label below. -->
        <Style x:Key="SLRibbonButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FF2B2B2B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3,8,3">
                            <StackPanel HorizontalAlignment="Center">
                                <Path x:Name="Icon"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="#FF1E6FD9"
                                      Width="20"
                                      Height="20"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center" />
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE5F1FB" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFA9CDF0" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFCCE4F7" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6FA8DC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Icon" Property="Fill" Value="#FFBBBBBB" />
                                <Setter TargetName="Label" Property="Foreground" Value="#FFAAAAAA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Scan toggle: play-radar icon normally, red stop icon with a highlighted look while scanning. -->
        <Style x:Key="SLRibbonScanButtonStyle" TargetType="Button" BasedOn="{StaticResource SLRibbonButtonStyle}">
            <Setter Property="Tag" Value="M12,2 A10,10 0 1 0 22,12 L20,12 A8,8 0 1 1 12,4 Z M12,6 A6,6 0 1 0 18,12 L16,12 A4,4 0 1 1 12,8 Z M11,11 L20.5,3.5 L22,5 L13,13 Z" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                    <Setter Property="Tag" Value="M6,6 L18,6 L18,18 L6,18 Z" />
                    <Setter Property="Background" Value="#FFFFE3E3" />
                    <Setter Property="BorderBrush" Value="#FFE8A0A0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Ribbon group: content on top, caption at the bottom, thin separator on the right. -->
        <Style x:Key="SLRibbonGroupStyle" TargetType="HeaderedContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border BorderBrush="#FFDADCE0" BorderThickness="0,0,1,0" Padding="6,4,6,2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Bottom"
                                           Text="{TemplateBinding Header}"
                                           Foreground="#FF6B6B6B"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                                <ContentPresenter HorizontalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border 
            Margin="0,0,0,8"
            Background="#FFF7F8FA"
            BorderBrush="#FFDADCE0"
            BorderThickness="1"
            CornerRadius="6"
            Padding="4">
        <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Left"
                       Text="Tasks"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FF2B2B2B"
                       Margin="8,0,12,0"
                       VerticalAlignment="Center" />
            <HeaderedContentControl DockPanel.Dock="Left" Header="Run" Style="{StaticResource SLRibbonGroupStyle}">
                <Button Content="Run All"
                        Style="{StaticResource SLRibbonButtonStyle}"
                        Tag="M8,5 L19,12 L8,19 Z"
                        Command="{Binding RunAllSLTasksCommand}" />
            </HeaderedContentControl>
            <HeaderedContentControl DockPanel.Dock="Left" Header="Schedule" Style="{StaticResource SLRibbonGroupStyle}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{Binding ScanButtonText}"
                            Style="{StaticResource SLRibbonScanButtonStyle}"
                            Command="{Binding ToggleScanCommand}" />
                    <Button Content="Schedule..."
                            Style="{StaticResource SLRibbonButtonStyle}"
                            Tag="M4,5 L20,5 L20,21 L4,21 Z M6,9 L6,19 L18,19 L18,9 Z M7,2 L9,2 L9,6 L7,6 Z M15,2 L17,2 L17,6 L15,6 Z M8,11 L11,11 L11,14 L8,14 Z M13,11 L16,11 L16,14 L13,14 Z M8,15 L11,15 L11,18 L8,18 Z"
                            Command="{Binding OpenScheduleCommand}" />
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl DockPanel.Dock="Left" Header="History" Style="{StaticResource SLRibbonGroupStyle}">
                <Button Content="Message History"
                        ToolTip="View Message History"
                        Style="{StaticResource SLRibbonButtonStyle}"
                        Tag="M13,3 A9,9 0 1 0 22,12 L20,12 A7,7 0 1 1 13,5 A7,7 0 0 1 18,7.1 L15.5,9.5 L22,9.5 L22,3 L19.4,5.6 A9,9 0 0 0 13,3 Z M12,7 L14,7 L14,12 L17.5,14 L16.5,15.7 L12,13.2 Z"
                        Command="{Binding ViewMessageHistoryCommand}" />
            </HeaderedContentControl>
            <TextBlock Text="{Binding ScanStatusText}"
                       Foreground="#FF6B6B6B"
                       TextWrapping="Wrap"
                       TextAlignment="Right"
                       Margin="12,0,8,0"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</UserControl>
